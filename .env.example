# Copy this file to .env.local for local development.
# In production, set these in the Netlify dashboard (Site settings → Environment variables).
# Do NOT commit a populated .env file.

# --- Auth (basic auth gate for the whole app) ---
AUTH_USERNAME=
AUTH_PASSWORD=
NEXTAUTH_SECRET=

# --- Anthropic (Roam-io assistant) ---
ANTHROPIC_API_KEY=
# Cosine-similarity threshold above which Roam-io memory entries are
# treated as duplicates. Optional — defaults are sensible.
MEMORY_DEDUPE_THRESHOLD=

# --- Brevo (transactional email + contact CRM) ---
BREVO_API_KEY=

# --- IMAP (reply polling into the contact timeline) ---
IMAP_USER=
IMAP_PASS=

# --- Unsplash (image search for social composer) ---
# Without this set, /api/images/search returns 503 and the social
# composer image picker shows an empty state.
UNSPLASH_ACCESS_KEY=

# --- Google Places (business discovery on /find) ---
GOOGLE_PLACES_API_KEY=

# --- LinkedIn OAuth (social publishing) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Meta OAuth (Facebook + Instagram publishing) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- Cron auth (protects scheduled job endpoints) ---
CRON_SECRET_V=
